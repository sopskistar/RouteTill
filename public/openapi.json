  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "routetill_session"
      },
      "agentToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped rt_demo_ or rt_live_ token created by a human session"
      }
    },
    "schemas": {
      "PurchasePolicy": {
        "type": "object",
        "required": [
          "version",
          "authorizationId",
          "merchantId",
          "merchantName",
          "recipient",
          "productId",
          "productName",
          "artifactSha256",
          "sourceAsset",
          "destinationAsset",
          "sourceChain",
          "destinationChain",
          "destinationToken",
          "destinationAmount",
          "maxSourceAmount",
          "refundAddress",
          "expiresAt",
          "mode"
        ],
        "properties": {
          "authorizationId": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "merchantName": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "artifactSha256": {
            "type": "string"
          },
