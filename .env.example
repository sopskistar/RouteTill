# Copy to .env.local. Never commit .env.local.
NEAR_INTENTS_JWT=
# Distinct Neon databases for production/live and synthetic judges.
DATABASE_URL=
DEMO_DATABASE_URL=
# Generate an Ed25519 PKCS8 PEM key; put literal \n between PEM lines.
PASSPORT_PRIVATE_KEY=
APP_ORIGIN=http://localhost:3001
ENABLE_LIVE_PAYMENTS=false
ENABLE_JUDGE_DEMO=true
JUDGE_ACCESS_CODE=
CRON_SECRET=
RECONCILE_WEBHOOK_SECRET=
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Optional external agent client
ROUTETILL_URL=http://localhost:3001
ROUTETILL_AGENT_TOKEN=
REFUND_ADDRESS=
