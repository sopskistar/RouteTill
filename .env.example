# Local development can use both stores. EACH Vercel project gets ONLY its own store/key.
# Generate distinct private release files: npm run release:init
# Server-only: obtain 1Click API key from the NEAR Intents developer dashboard.
NEAR_INTENTS_JWT=
# routetill-production Neon pooled URL (live project ONLY)
DATABASE_URL=
# routetill-demo Neon pooled URL (demo project ONLY)
DEMO_DATABASE_URL=
# Distinct Ed25519 PKCS8 PEM keys. Quoted, with literal \n between lines.
PASSPORT_PRIVATE_KEY=
DEMO_PASSPORT_PRIVATE_KEY=
APP_ORIGIN=http://localhost:3001
ENABLE_LIVE_PAYMENTS=false
# false on production; true on demo
ENABLE_JUDGE_DEMO=true
JUDGE_ACCESS_CODE=
CRON_SECRET=
# Optional authenticated reconciliation trigger; never accepts settlement assertions.
RECONCILE_WEBHOOK_SECRET=
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Optional nonsecret HTTPS origin for the separate judge deployment.
DEMO_APP_URL=
# OPTIONAL PUBLIC Reown project ID; required to activate WalletConnect pairing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional external agent client only; never put its token into NEXT_PUBLIC_*.
ROUTETILL_URL=http://localhost:3001
ROUTETILL_AGENT_TOKEN=
REFUND_ADDRESS=
